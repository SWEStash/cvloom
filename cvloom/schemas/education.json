{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "education",
  "title": "CV Education",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["institution", "degree", "start_date"],
    "additionalProperties": false,
    "properties": {
      "institution": {"type": "string"},
      "degree": {"type": "string"},
      "field": {"type": "string"},
      "location": {"type": "string"},
      "start_date": {"type": "string"},
      "end_date": {"type": "string"},
      "grade": {"type": "string"},
      "tags": {
        "type": "array",
        "items": {"type": "string"},
        "description": "Technology/domain tags for profile filtering"
      },
      "highlights": {
        "type": "array",
        "items": {
          "oneOf": [
            {"type": "string"},
            {
              "type": "object",
              "required": ["text"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "text": {"type": "string"}
              }
            }
          ]
        }
      }
    }
  }
}
