{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile",
  "title": "Build Profile",
  "type": "object",
  "required": [
    "template"
  ],
  "additionalProperties": false,
  "properties": {
    "template": {
      "type": "string",
      "description": "Template path relative to templates/, e.g. 'cv/ats-clean'"
    },
    "output_filename": {
      "type": "string",
      "description": "Base filename for outputs (without extension), e.g. 'jane-smith-cv'"
    },
    "sections": {
      "type": "object",
      "description": "Per-section include/exclude overrides",
      "additionalProperties": false,
      "properties": {
        "work": {
          "type": "boolean",
          "default": true
        },
        "education": {
          "type": "boolean",
          "default": true
        },
        "skills": {
          "type": "boolean",
          "default": true
        },
        "projects": {
          "type": "boolean",
          "default": true
        },
        "publications": {
          "type": "boolean",
          "default": true
        },
        "certifications": {
          "type": "boolean",
          "default": true
        },
        "awards": {
          "type": "boolean",
          "default": true
        },
        "languages": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "select": {
      "type": "object",
      "description": "Per-section content selection. A section not named here is untouched.",
      "additionalProperties": false,
      "properties": {
        "work": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keep only entries carrying at least one of these tags. An entry with no tags does not match."
            }
          }
        },
        "education": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keep only entries carrying at least one of these tags. An entry with no tags does not match."
            }
          }
        },
        "projects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keep only entries carrying at least one of these tags. An entry with no tags does not match."
            }
          }
        },
        "publications": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keep only entries carrying at least one of these tags. An entry with no tags does not match."
            }
          }
        },
        "certifications": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keep only entries carrying at least one of these tags. An entry with no tags does not match."
            }
          }
        },
        "awards": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keep only entries carrying at least one of these tags. An entry with no tags does not match."
            }
          }
        },
        "languages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keep only entries carrying at least one of these tags. An entry with no tags does not match."
            }
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "categories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keep only these skill categories"
            },
            "exclude_categories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Drop these skill categories; applied before `categories`"
            }
          }
        }
      }
    },
    "job_context": {
      "type": "object",
      "description": "Job-specific context for cover letter template",
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "hiring_manager": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "greeting": {
          "type": "string",
          "description": "Overrides the locale pack's greeting, e.g. 'Estimada' when the addressee is a woman. Spanish salutations agree with who receives them, which is a property of the application rather than of the language."
        },
        "closing": {
          "type": "string",
          "description": "Overrides the locale pack's sign-off, e.g. 'Un cordial saludo'."
        }
      }
    },
    "section_order": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "skills",
          "work",
          "education",
          "projects",
          "publications",
          "certifications",
          "awards",
          "languages"
        ]
      },
      "description": "Render sections in this order (overrides template default)"
    },
    "overlays": {
      "type": "object",
      "description": "Per-job data patches applied after tag filtering",
      "additionalProperties": false,
      "properties": {
        "basics": {
          "type": "object",
          "description": "Shallow merge into basics data",
          "properties": {
            "headline": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "work": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry_overlay"
          }
        },
        "education": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry_overlay"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry_overlay"
          }
        },
        "skills": {
          "$ref": "#/$defs/skills_overlay"
        }
      }
    },
    "section_titles": {
      "type": "object",
      "description": "Rename section headings. Text only \u2014 styling stays in the template. Keys not listed here keep the heading the chosen template supplies, so 'Core Competencies' in cv/executive-dark stays that unless renamed.",
      "propertyNames": {
        "enum": [
          "work",
          "skills",
          "education",
          "projects",
          "publications",
          "certifications",
          "awards",
          "languages",
          "summary",
          "professional_development",
          "contact"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "match_spec": {
      "type": "object",
      "description": "Field-value pairs to identify an entry (AND logic)",
      "additionalProperties": {
        "type": "string"
      }
    },
    "entry_overlay": {
      "type": "object",
      "required": [
        "match"
      ],
      "additionalProperties": false,
      "properties": {
        "match": {
          "$ref": "#/$defs/match_spec"
        },
        "exclude": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "highlights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "all",
                "pick",
                "exclude"
              ],
              "default": "all"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Highlight IDs to pick or exclude"
            },
            "append": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Extra highlights to add after filtered ones"
            },
            "replace": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Map of highlight ID to replacement text"
            }
          }
        }
      }
    },
    "skills_overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exclude_items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
