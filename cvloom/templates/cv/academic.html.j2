{% extends "base.html.j2" %}

{% block title %}{{ contact.name }} | Academic CV{% endblock %}

{% block css_vars %}
:root {
  --accent: #1a3a1a;
  --font-body: Georgia, "Times New Roman", serif;
  --page-padding: 20mm 18mm;
}
{% endblock %}

{% block css_extra %}
/* Academic CV: education-first, serif body, dense layout */
body { font-size: 10.5pt; }
h2 {
  font-size: 10.5pt;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: var(--accent);
  border-bottom: 1px solid var(--border);
  padding-bottom: 2px;
  margin: 16px 0 6px;
  font-family: Arial, Helvetica, sans-serif;
}
.header { margin-bottom: 12px; text-align: center; }
.header h1 { font-size: 18pt; font-family: Arial, Helvetica, sans-serif; margin-bottom: 0.4em; }
.header .headline { font-size: 11pt; color: var(--muted); margin-bottom: 5px; }
.contact-line { font-size: 9.5pt; color: var(--muted); text-align: center; }
.contact-line span + span::before { content: " | "; }
.entry { margin-bottom: 10px; }
.entry-title { font-weight: 700; }
.entry-org { font-style: italic; }
.entry-meta { font-size: 9.5pt; }
.entry-date, .entry-location { color: var(--muted); }
.skills-row { margin-bottom: 4px; font-size: 9.5pt; }
.skills-row .cat { font-weight: 700; display: inline; }
{% endblock %}

{# ── Section macros ────────────────────────────────────────────── #}

{% macro section_skills() %}
{% if show.skills and skills %}
<h2>{{ section_title("skills", "Technical Skills") }}</h2>
{% for group in skills %}
<div class="skills-row">
  <span class="cat">{{ group.category }}:</span>
  {% for item in group['items'] -%}
    {%- if item is mapping -%}{{ item.name }}{%- else -%}{{ item }}{%- endif -%}
    {%- if not loop.last %}, {% endif -%}
  {%- endfor %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_work() %}
{% if show.work and work %}
<h2>{{ section_title("work", "Positions Held") }}</h2>
{% for job in work %}
<div class="entry">
  <h3 class="entry-title">{{ job.title }}</h3>
  <div class="entry-meta"><span class="entry-org">{{ job.company }}</span><span class="entry-sep">, </span><span class="entry-date">{{ job.start_date | date_range(job.end_date | default(none)) }}</span>{% if job.location %}<span class="entry-sep">, </span><span class="entry-location">{{ job.location }}</span>{% endif %}</div>
  {% if job.highlights %}
  <ul>
    {% for h in job.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_education() %}
{% if show.education and education %}
<h2>{{ section_title("education", "Education") }}</h2>
{% for edu in education %}
<div class="entry">
  <h3 class="entry-title">{{ edu.degree }}{% if edu.field %} in {{ edu.field }}{% endif %}</h3>
  <div class="entry-meta"><span class="entry-org">{{ edu.institution }}</span><span class="entry-sep">, </span><span class="entry-date">{{ edu.start_date | date_range(edu.end_date | default(none)) }}</span>{% if edu.location %}<span class="entry-sep">, </span><span class="entry-location">{{ edu.location }}</span>{% endif %}</div>
  {% if edu.highlights %}
  <ul>
    {% for h in edu.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_projects() %}
{% if show.projects and projects %}
<h2>{{ section_title("projects", "Research &amp; Projects") }}</h2>
{% for proj in projects %}
<div class="entry">
  <h3 class="entry-title">{% if proj.url %}<a href="{{ proj.url }}">{{ proj.name }}</a>{% else %}{{ proj.name }}{% endif %}</h3>
  {% if proj.start_date %}<div class="entry-meta"><span class="entry-date">{{ proj.start_date | date_range(proj.end_date | default(none)) }}</span></div>{% endif %}
  {% if proj.description %}<p>{{ proj.description | md }}</p>{% endif %}
  {% if proj.highlights %}
  <ul>
    {% for h in proj.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_publications() %}
{% if show.publications and publications %}
<h2>{{ section_title("publications", "Publications") }}</h2>
{% for pub in publications %}
<div class="entry">
  <div class="entry-title">{% if pub.url %}<a href="{{ pub.url }}">{{ pub.name }}</a>{% else %}{{ pub.name }}{% endif %}</div>
  {% if pub.publisher or pub.identifier or pub.release_date %}
  <div><span class="entry-org">{{ pub.publisher }}</span>{% if pub.publisher and pub.identifier %}, {% endif %}{% if pub.identifier %}<span class="entry-location">{{ pub.identifier }}</span>{% endif %}{% if pub.release_date %}, <span class="entry-date">{{ pub.release_date }}</span>{% endif %}</div>
  {% endif %}
  {% if pub.summary %}<p>{{ pub.summary | md }}</p>{% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_certifications() %}
{% if show.certifications and certifications %}
{% for title_key, heading, group in certifications | cert_groups %}
<h2>{{ section_title(title_key, heading) }}</h2>
{% for cert in group %}
<div class="entry">
  <div class="entry-title">{% if cert.url %}<a href="{{ cert.url }}">{{ cert.name }}</a>{% else %}{{ cert.name }}{% endif %}</div>
  {% if cert.issuer or cert.identifier or cert.date %}<div class="entry-location">{{ cert.issuer }}{% if cert.issuer and cert.identifier %}, {% endif %}{{ cert.identifier }}{% if cert.date %}, <span class="entry-date">{{ cert.date }}{% if cert.expiry_date %} - {{ cert.expiry_date }}{% endif %}</span>{% endif %}</div>{% endif %}
</div>
{% endfor %}
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_awards() %}
{% if show.awards and awards %}
<h2>{{ section_title("awards", "Awards") }}</h2>
{% for award in awards %}
<div class="entry">
  <div class="entry-title">{{ award.title }}</div>
  {% if award.awarder or award.date %}<div class="entry-location">{{ award.awarder }}{% if award.awarder and award.date %}, {% endif %}{% if award.date %}<span class="entry-date">{{ award.date }}</span>{% endif %}</div>{% endif %}
  {% if award.summary %}<p>{{ award.summary | md }}</p>{% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_languages() %}
{% if show.languages and languages %}
<h2>{{ section_title("languages", "Languages") }}</h2>
<div class="languages">
  {%- for lang in languages -%}
  {{ lang.language }}{% if lang.fluency %} ({{ lang.fluency }}){% endif %}
  {%- if not loop.last %}, {% endif -%}
  {%- endfor %}
</div>
{% endif %}
{% endmacro %}

{# ── Section dispatch ──────────────────────────────────────────── #}

{% set _section_macros = {
  "skills": section_skills,
  "work": section_work,
  "education": section_education,
  "projects": section_projects,
  "publications": section_publications,
  "certifications": section_certifications,
  "awards": section_awards,
  "languages": section_languages,
} %}

{% block body %}
<!-- HEADER -->
<div class="header">
  <h1>{{ contact.name }}</h1>
  <div class="headline">{{ basics.headline }}</div>
  <div class="contact-line">
    {% if contact.email is defined %}<span>{{ contact.email }}</span>{% endif %}
    {% if contact.phone is defined %}<span>{{ contact.phone }}</span>{% endif %}
    {% if contact.location is defined %}<span>{{ contact.location }}</span>{% endif %}
    {% for link in basics.links | default([]) %}<span>{{ link | link_anchor }}</span>{% endfor %}
  </div>
</div>

<!-- SUMMARY / RESEARCH INTERESTS -->
{% if basics.summary %}
<h2>{{ section_title("summary", "Research Interests") }}</h2>
<p>{{ basics.summary | md }}</p>
{% endif %}

<!-- SECTIONS (ordered; academic default puts education first) -->
{% for sec in section_order | default(["education", "publications", "work", "projects", "skills", "certifications", "awards", "languages"]) %}
{{ _section_macros[sec]() }}
{% endfor %}
{% endblock %}
