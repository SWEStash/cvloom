{% extends "base.html.j2" %}

{% block fonts %}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
{% endblock %}

{% block css_vars %}
:root {
  --accent: #7c3aed;
  --accent-light: #ede9fe;
  --font-body: Inter, Arial, Helvetica, sans-serif;
}
{% endblock %}

{% block css_extra %}
/* Modern single-column with visual hierarchy */
.header {
  border-bottom: 3px solid var(--accent);
  padding-bottom: 10px;
  margin-bottom: 12px;
}
.header h1 { font-size: 22pt; color: var(--accent); margin-bottom: 2px; }
.header .headline { font-size: 12pt; color: var(--text); margin-bottom: 6px; }
.contact-pills { display: flex; flex-wrap: wrap; gap: 6px; font-size: 9pt; }
.contact-pill { background: var(--accent-light); color: var(--accent); border-radius: 12px; padding: 2px 10px; }
.section-title {
  font-size: 11pt; text-transform: uppercase; letter-spacing: .1em;
  color: var(--accent); font-weight: 700;
  border-bottom: 1.5px solid var(--accent); padding-bottom: 2px; margin: 16px 0 8px;
}
.entry { margin-bottom: 12px; }
.entry-header { overflow: hidden; margin-bottom: 2px; }
.entry-title { font-weight: 700; font-size: 10.5pt; }
.entry-org { color: var(--accent); font-weight: 600; }
.entry-date { float: right; color: var(--muted); font-size: 9pt; background: #f9fafb; padding: 1px 6px; border-radius: 4px; }
.entry-meta { color: var(--muted); font-size: 9pt; margin-bottom: 3px; }
.skills-container { display: flex; flex-direction: column; gap: 6px; }
.skill-group-title { font-weight: 700; color: var(--accent); font-size: 9.5pt; margin-bottom: 2px; }
.tags { display: flex; flex-wrap: wrap; gap: 4px; }
{% endblock %}

{# ── Section macros ────────────────────────────────────────────── #}

{% macro section_skills() %}
{% if show.skills and skills %}
<div class="section-title">Skills</div>
<div class="skills-container">
  {% for group in skills %}
  <div>
    <div class="skill-group-title">{{ group.category }}</div>
    <div class="tags">
      {% for item in group['items'] %}
      <span class="skill-tag">
        {%- if item is mapping -%}{{ item.name }}{%- else -%}{{ item }}{%- endif -%}
      </span>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro section_work() %}
{% if show.work and work %}
<div class="section-title">Experience</div>
{% for job in work %}
<div class="entry">
  <div class="entry-header clearfix">
    <span class="entry-title">{{ job.title }}</span>
    <span class="entry-date">{{ job.start_date | date_range(job.end_date | default(none)) }}</span>
  </div>
  <div class="entry-meta">
    <span class="entry-org">{{ job.company }}</span>
    {% if job.location %} · {{ job.location }}{% endif %}
  </div>
  {% if job.highlights %}
  <ul>
    {% for h in job.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
  {% if job.tags %}
  <div class="tags" style="margin-top:4px;">
    {% for tag in job.tags %}<span class="skill-tag">{{ tag }}</span>{% endfor %}
  </div>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_education() %}
{% if show.education and education %}
<div class="section-title">Education</div>
{% for edu in education %}
<div class="entry">
  <div class="entry-header clearfix">
    <span class="entry-title">{{ edu.degree }}{% if edu.field %} in {{ edu.field }}{% endif %}</span>
    <span class="entry-date">{{ edu.start_date | date_range(edu.end_date | default(none)) }}</span>
  </div>
  <div class="entry-meta">
    <span class="entry-org">{{ edu.institution }}</span>
    {% if edu.location %} · {{ edu.location }}{% endif %}
  </div>
  {% if edu.highlights %}
  <ul>
    {% for h in edu.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_projects() %}
{% if show.projects and projects %}
<div class="section-title">Projects</div>
{% for proj in projects %}
<div class="entry">
  <div class="entry-header clearfix">
    <span class="entry-title">
      {% if proj.url %}<a href="{{ proj.url }}">{{ proj.name }}</a>{% else %}{{ proj.name }}{% endif %}
    </span>
    {% if proj.start_date %}
    <span class="entry-date">{{ proj.start_date | date_range(proj.end_date | default(none)) }}</span>
    {% endif %}
  </div>
  {% if proj.description %}<p>{{ proj.description | md }}</p>{% endif %}
  {% if proj.highlights %}
  <ul>
    {% for h in proj.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
  {% if proj.tags %}
  <div class="tags" style="margin-top:4px;">
    {% for tag in proj.tags %}<span class="skill-tag">{{ tag }}</span>{% endfor %}
  </div>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_publications() %}
{% if show.publications and publications %}
<div class="section-title">Publications</div>
{% for pub in publications %}
<div class="entry">
  <div class="entry-header clearfix">
    <span class="entry-title">{% if pub.url %}<a href="{{ pub.url }}">{{ pub.name }}</a>{% else %}{{ pub.name }}{% endif %}</span>
    {% if pub.release_date %}<span class="entry-date">{{ pub.release_date }}</span>{% endif %}
  </div>
  {% if pub.publisher or pub.identifier %}
  <div class="entry-meta"><span class="entry-org">{{ pub.publisher }}</span>{% if pub.publisher and pub.identifier %} · {% endif %}{{ pub.identifier }}</div>
  {% endif %}
  {% if pub.summary %}<p>{{ pub.summary | md }}</p>{% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{# ── Section dispatch ──────────────────────────────────────────── #}

{% set _section_macros = {
  "skills": section_skills,
  "work": section_work,
  "education": section_education,
  "projects": section_projects,
  "publications": section_publications,
} %}

{% block body %}
<!-- HEADER -->
<div class="header">
  <h1>{{ contact.name }}</h1>
  <div class="headline">{{ basics.headline }}</div>
  <div class="contact-pills">
    {% if contact.email is defined %}<span class="contact-pill">{{ contact.email }}</span>{% endif %}
    {% if contact.phone is defined %}<span class="contact-pill">{{ contact.phone }}</span>{% endif %}
    {% if contact.location is defined %}<span class="contact-pill">{{ contact.location }}</span>{% endif %}
    {% if contact.linkedin is defined %}<span class="contact-pill">in/{{ contact.linkedin }}</span>{% endif %}
    {% if contact.github is defined %}<span class="contact-pill">gh/{{ contact.github }}</span>{% endif %}
    {% if contact.website is defined %}<span class="contact-pill">{{ contact.website }}</span>{% endif %}
  </div>
</div>

<!-- SUMMARY -->
{% if basics.summary %}
<div class="section-title">About</div>
<p>{{ basics.summary | md }}</p>
{% endif %}

<!-- SECTIONS (ordered) -->
{% for sec in section_order | default(["skills", "work", "education", "projects", "publications"]) %}
{{ _section_macros[sec]() }}
{% endfor %}
{% endblock %}
