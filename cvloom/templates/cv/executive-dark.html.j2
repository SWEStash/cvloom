{% extends "base.html.j2" %}

{% block fonts %}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap">
{% endblock %}

{% block css_vars %}
:root {
  /* Two accents: --accent reads on white, --accent-on-dark reads on the band. */
  --accent: #3f5a68;
  --accent-on-dark: #8fb3c7;
  --header-bg: #1f2328;
  --header-text: #f4f5f6;
  --header-muted: #9aa4ad;
  --font-body: "Source Sans 3", "Source Sans Pro", Calibri, Arial, sans-serif;
}
{% endblock %}

{% block css_extra %}
/* Executive dark-header design */
body { font-size: 10.5pt; }
.header {
  background: var(--header-bg);
  color: var(--header-text);
  padding: 20px 24px;
  margin: -12mm -14mm 0 -14mm;
  border-bottom: 3px solid var(--accent-on-dark);
  print-color-adjust: exact;
  -webkit-print-color-adjust: exact;
}
.header h1 {
  font-size: 24pt;
  color: var(--header-text);
  margin-bottom: 0.4em;
  font-weight: 700;
  letter-spacing: 0.02em;
}
.header .headline {
  font-size: 12pt;
  color: var(--accent-on-dark);
  margin-bottom: 10px;
  font-weight: 400;
}
.contact-row {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  font-size: 9pt;
  color: var(--header-muted);
  align-items: center;
}
/* Flex items: spaces inside `content` collapse against the flex gap, so the
   gutter has to be margin. */
.contact-row span + span::before { content: "·"; color: var(--accent-on-dark); margin-right: 5px; }
/* Lifted off the band rather than left on `--header-muted` like the text: a 1em
   mark is thin strokes where a letterform is solid, so the same colour that reads
   at 6.3:1 as text sinks into the carbon as an icon. */
.contact-icon { width: 1em; height: 1em; vertical-align: -0.15em; margin-right: 0.3em; }
/* Base scopes its header-link rule to `.contact-line`; this header is a
   `.contact-row`, so without this the links take `--accent` on the carbon band. */
.contact-row a { color: inherit; }
.contact-row span { white-space: nowrap; }

.section-title {
  font-size: 11pt;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--accent);
  font-weight: 700;
  border-left: 3px solid var(--accent);
  border-bottom: none;
  padding-left: 10px;
  margin: 20px 0 10px;
}
.summary {
  font-size: 10.5pt;
  font-style: italic;
  color: var(--text);
  margin: 16px 0 8px;
  line-height: 1.5;
}
.entry { margin-bottom: 14px; }
.entry-title { margin-bottom: 1px; }
.entry-company {
  font-weight: 700;
  font-size: 11pt;
  color: var(--text);
}
.entry-title {
  font-weight: 600;
  font-size: 10pt;
  color: var(--muted);
}
.entry-date {
  
  color: var(--muted);
  font-size: 9pt;
  font-weight: 600;
}
.entry-meta { color: var(--muted); font-size: 9pt; margin-bottom: 3px; }

.skills-list { margin-bottom: 2px; }
/* A table row, not two inline-blocks: cells state the line relationship outright
   so extractors keep a category with its values. The colon after the label is a
   required separator, not decoration. See docs/reference/ats-readiness.md. */
.skill-row { display: table; width: 100%; margin-bottom: 3px; font-size: 9.5pt; }
.skill-category {
  display: table-cell;
  width: 10.5em;
  padding-right: 0.7em;
  vertical-align: top;
  font-weight: 700;
  color: var(--accent);
}
.skill-items { display: table-cell; vertical-align: top; }
.entry.compact { margin-bottom: 5px; }

@media print {
  .header { margin: -18mm -16mm 0 -16mm; padding: 16mm 16mm 10px 16mm; }
  .entry-title, h2, h3, .section-title, .skill-category { color: #111111 !important; }
}
{% endblock %}

{# ── Section macros ────────────────────────────────────────────── #}

{% macro section_skills() %}
{% if show.skills and skills %}
<h2 class="section-title">{{ section_title("skills") }}</h2>
<div class="skills-list">
  {% for group in skills %}
  <div class="skill-row"><span class="skill-category">{{ group.category }}:</span><span class="skill-items">
    {%- for item in group['items'] -%}
      {%- if item is mapping -%}{{ item.name }}{%- else -%}{{ item }}{%- endif -%}
      {%- if not loop.last %}, {% endif -%}
    {%- endfor -%}
  </span></div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro section_work() %}
{% if show.work and work %}
<h2 class="section-title">{{ section_title("work") }}</h2>
{% for job in work %}
<div class="entry">
  <h3 class="entry-title">{{ job.title }}</h3>
  <div class="entry-meta"><span class="entry-org">{{ job.company }}</span><span class="entry-sep"> · </span><span class="entry-date">{{ job.start_date | date_range(job.end_date | default(none)) }}</span>{% if job.location %}<span class="entry-sep"> · </span><span class="entry-location">{{ job.location }}</span>{% endif %}</div>
  {% if job.highlights %}
  <ul>
    {% for h in job.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_education() %}
{% if show.education and education %}
<h2 class="section-title">{{ section_title("education") }}</h2>
{% for edu in education %}
<div class="entry">
  <h3 class="entry-title">{{ edu | degree_line }}</h3>
  <div class="entry-meta"><span class="entry-org">{{ edu.institution }}</span><span class="entry-sep"> · </span><span class="entry-date">{{ edu.start_date | date_range(edu.end_date | default(none)) }}</span>{% if edu.location %}<span class="entry-sep"> · </span><span class="entry-location">{{ edu.location }}</span>{% endif %}</div>
  {% if edu.highlights %}
  <ul>
    {% for h in edu.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_projects() %}
{% if show.projects and projects %}
<h2 class="section-title">{{ section_title("projects") }}</h2>
{% for proj in projects %}
<div class="entry">
  <h3 class="entry-title">{% if proj.url %}<a href="{{ proj.url }}">{{ proj.name }}</a>{% else %}{{ proj.name }}{% endif %}</h3>
  {% if proj.start_date %}<div class="entry-meta"><span class="entry-date">{{ proj.start_date | date_range(proj.end_date | default(none)) }}</span></div>{% endif %}
  {% if proj.description %}<p>{{ proj.description | md }}</p>{% endif %}
  {% if proj.highlights %}
  <ul>
    {% for h in proj.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_publications() %}
{% if show.publications and publications %}
<h2 class="section-title">{{ section_title("publications") }}</h2>
{% for pub in publications %}
<div class="entry">
{# Date runs inline on the meta line, unlike work/education above: these entries are
   two short lines each. #}
  <div class="entry-company">{% if pub.url %}<a href="{{ pub.url }}">{{ pub.name }}</a>{% else %}{{ pub.name }}{% endif %}</div>
  {% if pub.publisher or pub.identifier or pub.release_date %}
  <div class="entry-title">{{ pub.publisher }}{% if pub.publisher and pub.identifier %} · {% endif %}{{ pub.identifier }}{% if pub.release_date %} · {{ pub.release_date }}{% endif %}</div>
  {% endif %}
  {% if pub.summary %}<p>{{ pub.summary | md }}</p>{% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_certifications() %}
{% if show.certifications and certifications %}
{% for title_key, group in certifications | cert_groups %}
<h2 class="section-title">{{ section_title(title_key) }}</h2>
{% for cert in group %}
<div class="entry compact">
  <div class="entry-title">{% if cert.url %}<a href="{{ cert.url }}">{{ cert.name }}</a>{% else %}{{ cert.name }}{% endif %}</div>
  {% if cert.issuer or cert.identifier or cert.date %}
  <div class="entry-meta">{{ cert.issuer }}{% if cert.issuer and cert.identifier %} · {% endif %}{{ cert.identifier }}{% if cert.date %} · {{ cert.date }}{% if cert.expiry_date %} - {{ cert.expiry_date }}{% endif %}{% endif %}</div>
  {% endif %}
</div>
{% endfor %}
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_awards() %}
{% if show.awards and awards %}
<h2 class="section-title">{{ section_title("awards") }}</h2>
{% for award in awards %}
<div class="entry">
  <div class="entry-title">{{ award.title }}</div>
  {% if award.awarder or award.date %}
  <div class="entry-meta">{{ award.awarder }}{% if award.awarder and award.date %} · {% endif %}{{ award.date }}</div>
  {% endif %}
  {% if award.summary %}<p>{{ award.summary | md }}</p>{% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_languages() %}
{% if show.languages and languages %}
<h2 class="section-title">{{ section_title("languages") }}</h2>
<div class="languages">
  {%- for lang in languages -%}
  {{ lang.language }}{% if lang.fluency %} ({{ lang.fluency }}){% endif %}
  {%- if not loop.last %} · {% endif -%}
  {%- endfor %}
</div>
{% endif %}
{% endmacro %}

{# ── Section dispatch ──────────────────────────────────────────── #}

{% set _section_macros = {
  "skills": section_skills,
  "work": section_work,
  "education": section_education,
  "projects": section_projects,
  "publications": section_publications,
  "certifications": section_certifications,
  "awards": section_awards,
  "languages": section_languages,
} %}

{% block body %}
{# The icon fill is a literal: an SVG presentation attribute cannot read a CSS
   variable, and WeasyPrint resolves no CSS against an inline SVG. Keep in step
   with `--header-text`. #}
{% set icon_fill = "#f4f5f6" %}
<!-- HEADER -->
<div class="header">
  <h1>{{ contact.name }}</h1>
  <div class="headline">{{ basics.headline }}</div>
  <div class="contact-row">
    {% if contact.email is defined %}<span>{{ icon("envelope", icon_fill) }}{{ contact.email }}</span>{% endif %}
    {% if contact.phone is defined %}<span>{{ icon("phone", icon_fill) }}{{ contact.phone }}</span>{% endif %}
    {% if contact.location is defined %}<span>{{ icon("globe-americas", icon_fill) }}{{ contact.location }}</span>{% endif %}
    {% for link in basics.links | default([]) %}<span>{{ link | link_icon(icon_fill) }}{{ link | link_anchor }}</span>{% endfor %}
  </div>
</div>

<!-- EXECUTIVE SUMMARY -->
{% if basics.summary %}
<h2 class="section-title">{{ section_title("summary") }}</h2>
<div class="summary">{{ basics.summary | md }}</div>
{% endif %}

<!-- SECTIONS (ordered) -->
{% for sec in section_order | default(["work", "skills", "education", "projects", "publications", "certifications", "awards", "languages"]) %}
{{ _section_macros[sec]() }}
{% endfor %}
{% endblock %}
