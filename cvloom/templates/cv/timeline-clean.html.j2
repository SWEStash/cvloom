{% extends "base.html.j2" %}

{% block fonts %}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
{% endblock %}

{% block css_vars %}
:root {
  --accent: #2563eb;
  /* Light grey, a shade darker than `--border`. The rule is a solid fill now, so
     it does not need colour to survive the PDF — grey keeps the blue for the dots,
     which are the marks that carry meaning. */
  --timeline-line: #d1d5db;
  --timeline-dot: #2563eb;
  --font-body: Inter, "Helvetica Neue", Arial, sans-serif;
}
{% endblock %}

{% block css_extra %}
/* Minimalist Swiss design with timeline */
.header h1 {
  font-size: 24pt;
  font-weight: 300;
  color: var(--text);
  margin-bottom: 0.4em;
  letter-spacing: -0.01em;
}
.header .headline {
  font-size: 11pt;
  color: var(--muted);
  font-weight: 400;
  margin-bottom: 6px;
}
.contact-line {
  font-size: 9pt;
  color: var(--muted);
  margin-bottom: 4px;
}
/* Separators come from CSS, not from the markup. Emitting a literal `|` before
   each field assumes the fields before it rendered — under `--public`, where
   email/phone/location are dropped entirely, the line opened with a dangling
   separator. An adjacent-sibling rule can only match a span that actually has a
   span before it. */
.contact-line span + span::before { content: " | "; }

.section-title {
  font-size: 9pt;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
  font-weight: 600;
  border-bottom: none;
  margin: 20px 0 10px;
}
.summary {
  color: var(--text);
  margin-bottom: 8px;
  line-height: 1.55;
}

/* Timeline entries for work and education */
.timeline-section { margin-left: 10px; }
/* The line is a `border-left`, and the dot is a background on the entry's own
   title — not the other way round, and not a positioned pseudo-element.

   Three constraints meet here, and each one rules out the obvious answer:

   1. Nothing may be positioned. `position: relative` on the entry makes it a
      positioned box, and positioned boxes paint in a later pass than in-flow
      content — which put the whole timeline *after* the sections that follow it
      in the content stream, so SKILLS and EDUCATION extracted from the middle of
      the work history. Invisible on the page, fatal to a parser.

   2. The line must be a solid fill, not a gradient. Drawn as a background layer
      it reached the PDF as a full-page axial shading inside a transparency group,
      whose visible 2px is nothing but alpha in the colour function. Poppler
      resolves that; other viewers rasterize the soft mask coarsely and a 2px
      feature disappears entirely — the line rendered here and was missing in
      Preview and in Chrome's viewer, which reads as "the template is broken".
      A border is emitted as a plain filled rectangle and has no such failure mode.

   3. The dot must paint *after* the line, or the line swallows it. A border paints
      over its own element's background, so the dot cannot live on the entry. It
      lives on the entry's first child instead: in-flow descendants' backgrounds
      paint after the parent's border, and the negative margin is what lets that
      child reach back over a border that sits outside its own content box. The
      matching padding puts the text back where it was, so extraction is unchanged.

   The dot stays a radial gradient — same shading machinery as (2), but an opaque
   circle survives a coarse mask where a 2px line does not. */
.timeline-entry {
  padding-left: 22px;
  border-left: 2px solid var(--timeline-line);
  padding-bottom: 14px;
  padding-top: 1px;
}
.timeline-entry:last-child {
  border-left-color: transparent;
  padding-bottom: 0;
}
/* Both offsets are the same trick in two axes: pull the title's box out past the
   entry's edge with a negative margin, then push its text back with an equal
   padding, so the dot can be painted somewhere the text never goes.

   Horizontally, -28px reaches 4px past the entry's border box, putting the border's
   centre at x=5px in the title's coordinates — the dot's full 4px radius then fits
   inside the child and is never clipped.

   Vertically, -6px lifts the dot to 3px below the entry's top edge, which is where
   its border starts. Without it the dot sat at 9px: the border began 9px above one
   dot and ended 9px above the *next*, so the rule ran between the entries instead of
   joining them, visibly floating clear of both marks. 3px is inside the dot's own 4px
   radius, so each segment's ends are covered by the dots they run to and the line
   reads as continuous — while the dot still sits level with its title rather than
   riding above it, which is where a flush 0px offset would put it. The transparent
   border on `:last-child` stops the line at the final dot rather than trailing past
   it. Changing the dot's `9px` here means changing this offset by the same amount. */
.timeline-entry > .entry-title {
  margin-left: -28px;
  padding-left: 28px;
  margin-top: -6px;
  padding-top: 6px;
  background-image: radial-gradient(circle 4px at 5px 9px, var(--timeline-dot) 99%, transparent 100%);
  background-repeat: no-repeat;
}
.timeline-entry .timeline-entry .entry-title { font-weight: 600; font-size: 10.5pt; }
.timeline-entry .entry-org { color: var(--accent); font-weight: 500; }
.timeline-entry .entry-meta { color: var(--muted); font-size: 9pt; margin-bottom: 3px; }

/* Skills. The 1fr-1fr grid of flex rows this replaces let every label be its own
   width, so the values restarted at a different x on each row and in both columns
   at once — sixteen ragged left edges, reading as scatter rather than a list. */
.skills-list { margin-bottom: 2px; }
/* An aligned label column and single-line text extraction cannot both be had: the
   whitespace that does the aligning is exactly what an extractor reads as a column
   boundary, so a short label like `Networking` comes back on its own line ahead of
   its values. The pairing survives as reading order rather than as adjacency, which
   is the trade the design-led templates make and `cv/ats-clean` does not — it runs
   `Category: items` ragged and inline, and extracts as one line every time.
   `vertical-align: top` gives a label that wraps a hanging indent rather than
   pushing its own values down. */
/* A table row, for the same reason the entry header is one: two inline-blocks
   sitting side by side are only implicitly one line, and pypdf resolved that
   implication differently from pdftotext — a value at the wrap point drifted out
   of its own category's run. Table cells state the relationship outright, and both
   extractors then emit `category` immediately followed by all of its values.

   The colon after the label is a separator, not decoration. The gap between the
   columns is padding, and padding puts no character in the text stream — so when a
   label fills its cell, pypdf emitted `CLOUDOPSSV01i0`, fusing the category and its
   first skill into a single unsearchable token. A colon guarantees a separator that
   every tokeniser splits on, whatever the label's width. */
.skill-row { display: table; width: 100%; margin-bottom: 3px; font-size: 9pt; }
.skill-category {
  display: table-cell;
  width: 10.5em;
  padding-right: 0.7em;
  vertical-align: top;
  font-weight: 600;
  color: var(--accent);
}
.skill-items { display: table-cell; vertical-align: top; }

/* Plain entries for projects */
/* `:not()` because a timeline entry now carries `entry` too — it takes base's
   page-break guarantee from the role class and its spacing from its own
   `padding-bottom`, so the plain-entry margin would stack a second gap on it. */
.entry:not(.timeline-entry) { margin-bottom: 12px; }
.entry-title { font-weight: 600; font-size: 10.5pt; }
.entry-date { color: var(--muted); font-size: 8.5pt; }
{% endblock %}

{# ── Section macros ────────────────────────────────────────────── #}

{% macro section_skills() %}
{% if show.skills and skills %}
<h2 class="section-title">{{ section_title("skills", "Skills") }}</h2>
<div class="skills-list">
  {% for group in skills %}
  <div class="skill-row"><span class="skill-category">{{ group.category }}:</span><span class="skill-items">
    {%- for item in group['items'] -%}
      {%- if item is mapping -%}{{ item.name }}{%- else -%}{{ item }}{%- endif -%}
      {%- if not loop.last %}, {% endif -%}
    {%- endfor -%}
  </span></div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro section_work() %}
{% if show.work and work %}
<h2 class="section-title">{{ section_title("work", "Experience") }}</h2>
<div class="timeline-section">
  {% for job in work %}
  <div class="entry timeline-entry">
    <h3 class="entry-title">{{ job.title }}</h3>
    <div class="entry-meta"><span class="entry-org">{{ job.company }}</span><span class="entry-sep"> · </span><span class="entry-date">{{ job.start_date | date_range(job.end_date | default(none)) }}</span>{% if job.location %}<span class="entry-sep"> · </span><span class="entry-location">{{ job.location }}</span>{% endif %}</div>
    {% if job.highlights %}
    <ul>
      {% for h in job.highlights %}<li>{{ h | md }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro section_education() %}
{% if show.education and education %}
<h2 class="section-title">{{ section_title("education", "Education") }}</h2>
<div class="timeline-section">
  {% for edu in education %}
  <div class="entry timeline-entry">
    <h3 class="entry-title">{{ edu.degree }}{% if edu.field %} in {{ edu.field }}{% endif %}</h3>
    <div class="entry-meta"><span class="entry-org">{{ edu.institution }}</span><span class="entry-sep"> · </span><span class="entry-date">{{ edu.start_date | date_range(edu.end_date | default(none)) }}</span>{% if edu.location %}<span class="entry-sep"> · </span><span class="entry-location">{{ edu.location }}</span>{% endif %}</div>
    {% if edu.highlights %}
    <ul>
      {% for h in edu.highlights %}<li>{{ h | md }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro section_projects() %}
{% if show.projects and projects %}
<h2 class="section-title">{{ section_title("projects", "Projects") }}</h2>
{% for proj in projects %}
<div class="entry">
  <h3 class="entry-title">{% if proj.url %}<a href="{{ proj.url }}">{{ proj.name }}</a>{% else %}{{ proj.name }}{% endif %}</h3>
  {% if proj.start_date %}<div class="entry-meta"><span class="entry-date">{{ proj.start_date | date_range(proj.end_date | default(none)) }}</span></div>{% endif %}
  {% if proj.description %}<p>{{ proj.description | md }}</p>{% endif %}
  {% if proj.highlights %}
  <ul>
    {% for h in proj.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_publications() %}
{% if show.publications and publications %}
<h2 class="section-title">{{ section_title("publications", "Publications") }}</h2>
<div class="timeline-section">
  {% for pub in publications %}
  <div class="entry timeline-entry">
{# Date runs inline on the meta line, unlike work/education above: these entries are
   two short lines each. #}
    <div class="entry-title">{% if pub.url %}<a href="{{ pub.url }}">{{ pub.name }}</a>{% else %}{{ pub.name }}{% endif %}</div>
    {% if pub.publisher or pub.identifier or pub.release_date %}
    <div class="entry-meta"><span class="entry-org">{{ pub.publisher }}</span>{% if pub.publisher and pub.identifier %} · {% endif %}{{ pub.identifier }}{% if pub.release_date %} · {{ pub.release_date }}{% endif %}</div>
    {% endif %}
    {% if pub.summary %}<p>{{ pub.summary | md }}</p>{% endif %}
  </div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro section_certifications() %}
{% if show.certifications and certifications %}
{% for title_key, heading, group in certifications | cert_groups %}
<h2 class="section-title">{{ section_title(title_key, heading) }}</h2>
<div class="timeline-section">
  {% for cert in group %}
  <div class="entry timeline-entry">
    <div class="entry-title">{% if cert.url %}<a href="{{ cert.url }}">{{ cert.name }}</a>{% else %}{{ cert.name }}{% endif %}</div>
    {% if cert.issuer or cert.identifier or cert.date %}
    <div class="entry-meta">{{ cert.issuer }}{% if cert.issuer and cert.identifier %} · {% endif %}{{ cert.identifier }}{% if cert.date %} · {{ cert.date }}{% if cert.expiry_date %} - {{ cert.expiry_date }}{% endif %}{% endif %}</div>
    {% endif %}
  </div>
  {% endfor %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_awards() %}
{% if show.awards and awards %}
<h2 class="section-title">{{ section_title("awards", "Awards") }}</h2>
{% for award in awards %}
<div class="entry">
  <div class="entry-title">{{ award.title }}</div>
  {% if award.awarder or award.date %}
  <div class="entry-meta">{{ award.awarder }}{% if award.awarder and award.date %} · {% endif %}{{ award.date }}</div>
  {% endif %}
  {% if award.summary %}<p>{{ award.summary | md }}</p>{% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro section_languages() %}
{% if show.languages and languages %}
<h2 class="section-title">{{ section_title("languages", "Languages") }}</h2>
<div class="languages">
  {%- for lang in languages -%}
  {{ lang.language }}{% if lang.fluency %} ({{ lang.fluency }}){% endif %}
  {%- if not loop.last %} · {% endif -%}
  {%- endfor %}
</div>
{% endif %}
{% endmacro %}

{# ── Section dispatch ──────────────────────────────────────────── #}

{% set _section_macros = {
  "skills": section_skills,
  "work": section_work,
  "education": section_education,
  "projects": section_projects,
  "publications": section_publications,
  "certifications": section_certifications,
  "awards": section_awards,
  "languages": section_languages,
} %}

{% block body %}
<!-- HEADER -->
<div class="header">
  <h1>{{ contact.name }}</h1>
  <div class="headline">{{ basics.headline }}</div>
  <div class="contact-line">
    {% if contact.email is defined %}<span>{{ contact.email }}</span>{% endif %}
    {% if contact.phone is defined %}<span>{{ contact.phone }}</span>{% endif %}
    {% if contact.location is defined %}<span>{{ contact.location }}</span>{% endif %}
    {% for link in basics.links | default([]) %}<span>{{ link | link_anchor }}</span>{% endfor %}
  </div>
</div>

<!-- SUMMARY -->
{% if basics.summary %}
<div class="summary">{{ basics.summary | md }}</div>
{% endif %}

<!-- SECTIONS (ordered) -->
{% for sec in section_order | default(["work", "skills", "education", "projects", "publications", "certifications", "awards", "languages"]) %}
{{ _section_macros[sec]() }}
{% endfor %}
{% endblock %}
