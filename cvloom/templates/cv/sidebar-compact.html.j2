{% extends "base.html.j2" %}

{% block fonts %}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap">
{% endblock %}

{% block css_vars %}
:root {
  --accent: #0f766e;
  --accent-light: #f0fdfa;
  --sidebar-bg: #0f766e;
  --sidebar-text: #ffffff;
  --sidebar-muted: rgba(255, 255, 255, 0.7);
  --font-body: Lato, Calibri, "Segoe UI", Arial, sans-serif;
}
{% endblock %}

{% block css_extra %}
/* Two-column sidebar layout */
/* CSS table, not CSS grid: WeasyPrint's grid fragmentation across page breaks is
   superlinear in page count (69s vs 6.5s on a 60-entry CV). Do not convert. */
.layout {
  display: table;
  table-layout: fixed;
  width: 100%;
  margin: -12mm -14mm;
}
.sidebar {
  display: table-cell;
  width: 190px;
  vertical-align: top;
  background: var(--sidebar-bg);
  color: var(--sidebar-text);
  /* Keep in step with `.main`: the two columns share a top edge. */
  padding: 8mm 12px 12mm 12px;
  print-color-adjust: exact;
  -webkit-print-color-adjust: exact;
}
.sidebar h1 {
  font-size: 18pt;
  color: var(--sidebar-text);
  margin-bottom: 0.4em;
  line-height: 1.2;
}
.sidebar .headline {
  font-size: 9.5pt;
  color: var(--sidebar-muted);
  margin-bottom: 14px;
}
.sidebar .section-title {
  font-size: 8.5pt;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--sidebar-muted);
  border-bottom: 1px solid rgba(255, 255, 255, 0.25);
  padding-bottom: 2px;
  margin: 14px 0 6px;
  font-weight: 700;
}
.sidebar .contact-list {
  list-style: none;
  padding: 0;
  font-size: 8.5pt;
}
.sidebar .contact-list li {
  margin-bottom: 5px;
}
.sidebar .contact-label {
  display: block;
  font-size: 7pt;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--sidebar-muted);
}
.sidebar .contact-value {
  color: var(--sidebar-text);
  word-break: break-all;
}
.sidebar .contact-list a { color: inherit; }
.sidebar .contact-icon { width: 1em; height: 1em; vertical-align: -0.15em; margin-right: 0.3em; }
.sidebar .skill-group { margin-bottom: 5px; break-inside: avoid; page-break-inside: avoid; }
.sidebar .skill-group-title {
  font-weight: 700;
  font-size: 8.5pt;
  margin-bottom: 1px;
  color: var(--sidebar-text);
}
.sidebar .skill-items {
  font-size: 8pt;
  color: var(--sidebar-muted);
  line-height: 1.3;
}
/* `skill_level_bar` renders an empty span carrying the level in a CSS class, so
   it puts no text in the PDF. Only items with a `level` render one. */
.sidebar .skill-level { width: 26px; height: 4px; background: rgba(255, 255, 255, 0.25); }
.sidebar .skill-level::after { background: var(--sidebar-text); }
/* A skill and its bar are one unit; the line breaks after the comma instead. */
.sidebar .skill-item { white-space: nowrap; }
.sidebar .entry { margin-bottom: 8px; }
.sidebar .entry-title { font-weight: 700; font-size: 9pt; }
.sidebar .entry-meta { color: var(--sidebar-muted); font-size: 8pt; }
.sidebar .entry-date { color: var(--sidebar-muted); font-size: 7.5pt; }
.sidebar .languages {
  font-size: 8pt;
  color: var(--sidebar-muted);
  line-height: 1.3;
}

.main {
  display: table-cell;
  vertical-align: top;
  padding: 8mm 14mm 12mm 20px;
}
.main .section-title {
  font-size: 11pt;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent);
  font-weight: 700;
  border-left: 3px solid var(--accent);
  border-bottom: none;
  padding-left: 8px;
  padding-bottom: 0;
  margin: 16px 0 8px;
}
.main .entry { margin-bottom: 12px; }
.main .entry-header { margin-bottom: 2px; }
.main .entry-title { font-weight: 700; font-size: 10.5pt; }
.entry-header > .entry-title { flex: 0 1 auto; }
.main .entry-org { color: var(--accent); font-weight: 600; }
.main .entry-date, .main .entry-duration { color: var(--muted); font-size: 9pt; }
.main .entry-meta { color: var(--muted); font-size: 9pt; margin-bottom: 3px; }

@media print {
  .layout { margin: 0; }
  /* `box-decoration-break: clone` restores padding on continuation pages: a
     fragmented box otherwise draws it only at the very start and end. */
  .sidebar {
    padding: 8mm 12px 12mm 12px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .main {
    padding: 8mm 0 12mm 16px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
}
{% endblock %}

{# ── Sidebar section macros ─────────────────────────────────────── #}

{% macro sidebar_skills() %}
{% if show.skills and skills %}
<h2 class="section-title">{{ section_title("skills") }}</h2>
{% for group in skills %}
<div class="skill-group">
  <div class="skill-group-title">{{ group.category }}</div>
  <div class="skill-items">
    {%- for item in group['items'] -%}
      {%- if item is mapping -%}
        <span class="skill-item">{{ item.name }}{% if item.level %}{{ item.level | skill_level_bar }}{% endif %}</span>
      {%- else -%}{{ item }}{%- endif -%}
      {%- if not loop.last %}, {% endif -%}
    {%- endfor -%}
  </div>
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro sidebar_education() %}
{% if show.education and education %}
<h2 class="section-title">{{ section_title("education") }}</h2>
{% for edu in education %}
<div class="entry">
  <h3 class="entry-title">{{ edu | degree_line }}</h3>
  <div class="entry-meta">{{ edu.institution }}</div>
  <div class="entry-date">{{ edu.start_date | date_range(edu.end_date | default(none)) }}</div>
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{# ── Main section macros ────────────────────────────────────────── #}

{% macro main_work() %}
{% if show.work and work %}
<h2 class="section-title">{{ section_title("work") }}</h2>
{% for job in work %}
<div class="entry">
  <div class="entry-header">
    <h3 class="entry-title">{{ job.title }}</h3>
    <span class="entry-date">{{ job.start_date | date_range(job.end_date | default(none)) }}</span>{% if show_durations | default(false) %}{% set _dur = job.start_date | duration(job.end_date | default(none)) %}{% if _dur %}<span class="entry-duration"> {{ _dur }}</span>{% endif %}{% endif %}
  </div>
  <div class="entry-meta">
    <span class="entry-org">{{ job.company }}</span>
    {% if job.location %} · {{ job.location }}{% endif %}
  </div>
  {% if job.highlights %}
  <ul>
    {% for h in job.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro main_projects() %}
{% if show.projects and projects %}
<h2 class="section-title">{{ section_title("projects") }}</h2>
{% for proj in projects %}
<div class="entry">
  <div class="entry-header">
    <h3 class="entry-title">
      {% if proj.url %}<a href="{{ proj.url }}">{{ proj.name }}</a>{% else %}{{ proj.name }}{% endif %}
    </h3>
    {% if proj.start_date %}
    <span class="entry-date">{{ proj.start_date | date_range(proj.end_date | default(none)) }}</span>
    {% endif %}
  </div>
  {% if proj.description %}<p>{{ proj.description | md }}</p>{% endif %}
  {% if proj.highlights %}
  <ul>
    {% for h in proj.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro main_publications() %}
{% if show.publications and publications %}
<h2 class="section-title">{{ section_title("publications") }}</h2>
{% for pub in publications %}
<div class="entry">
  <h3 class="entry-title">{% if pub.url %}<a href="{{ pub.url }}">{{ pub.name }}</a>{% else %}{{ pub.name }}{% endif %}</h3>
  {% if pub.publisher or pub.identifier %}
  <div class="entry-meta">{{ pub.publisher }}{% if pub.publisher and pub.identifier %} · {% endif %}{{ pub.identifier }}</div>
  {% endif %}
  {% if pub.release_date %}<div class="entry-date">{{ pub.release_date }}</div>{% endif %}
  {% if pub.summary %}<p>{{ pub.summary | md }}</p>{% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro sidebar_certifications() %}
{% if show.certifications and certifications %}
{% for title_key, group in certifications | cert_groups %}
<h2 class="section-title">{{ section_title(title_key) }}</h2>
{% for cert in group %}
<div class="entry">
  <h3 class="entry-title">{% if cert.url %}<a href="{{ cert.url }}">{{ cert.name }}</a>{% else %}{{ cert.name }}{% endif %}</h3>
  {% if cert.issuer or cert.identifier %}<div class="entry-meta">{{ cert.issuer }}{% if cert.issuer and cert.identifier %} · {% endif %}{{ cert.identifier }}</div>{% endif %}
  {% if cert.date %}<div class="entry-date">{{ cert.date }}
  {%- if cert.expiry_date %} - {{ cert.expiry_date }}{% endif %}</div>{% endif %}
</div>
{% endfor %}
{% endfor %}
{% endif %}
{% endmacro %}

{% macro main_awards() %}
{% if show.awards and awards %}
<h2 class="section-title">{{ section_title("awards") }}</h2>
{% for award in awards %}
<div class="entry">
  <div class="entry-header">
    <h3 class="entry-title">{{ award.title }}</h3>
    {% if award.date %}<span class="entry-date">{{ award.date }}</span>{% endif %}
  </div>
  {% if award.awarder %}<div class="entry-meta">{{ award.awarder }}</div>{% endif %}
  {% if award.summary %}<p>{{ award.summary | md }}</p>{% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro sidebar_languages() %}
{% if show.languages and languages %}
<h2 class="section-title">{{ section_title("languages") }}</h2>
<div class="languages">
  {%- for lang in languages -%}
  <div>
  {{ lang.language }}{% if lang.fluency %} ({{ lang.fluency }}){% endif %}
  </div>
  {%- endfor %}
</div>
{% endif %}
{% endmacro %}

{# ── Section dispatch maps ──────────────────────────────────────── #}

{% set _sidebar_macros = {
  "skills": sidebar_skills,
  "education": sidebar_education,
  "certifications": sidebar_certifications,
  "languages": sidebar_languages,
} %}

{% set _main_macros = {
  "work": main_work,
  "projects": main_projects,
  "publications": main_publications,
  "awards": main_awards,
} %}

{% block body %}
{# The icon fill is a literal: an SVG presentation attribute cannot read a CSS
   variable, and WeasyPrint resolves no CSS against an inline SVG. Keep in step
   with `--sidebar-text`. #}
{% set icon_fill = "#ffffff" %}
<div class="layout">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <h1>{{ contact.name }}</h1>
    <div class="headline">{{ basics.headline }}</div>

    <h2 class="section-title">{{ section_title("contact") }}</h2>
    <ul class="contact-list">
      {% if contact.email is defined %}<li><span class="contact-label">{{ icon("envelope", icon_fill) }}Email</span><span class="contact-value">{{ contact.email }}</span></li>{% endif %}
      {% if contact.phone is defined %}<li><span class="contact-label">{{ icon("phone", icon_fill) }}Phone</span><span class="contact-value">{{ contact.phone }}</span></li>{% endif %}
      {% if contact.location is defined %}<li><span class="contact-label">{{ icon("globe-americas", icon_fill) }}Location</span><span class="contact-value">{{ contact.location }}</span></li>{% endif %}
      {% for link in basics.links | default([]) %}<li><span class="contact-label">{{ link | link_icon(icon_fill) }}{{ link.label }}</span><span class="contact-value">{{ link | link_anchor }}</span></li>{% endfor %}
    </ul>

    {% for sec in section_order | default(["work", "skills", "education", "projects", "publications", "certifications", "awards", "languages"]) if sec in _sidebar_macros %}
    {{ _sidebar_macros[sec]() }}
    {% endfor %}
  </aside>

  <!-- MAIN -->
  <main class="main">
    {% if basics.summary %}
    <p style="margin-bottom: 12px;">{{ basics.summary | md }}</p>
    {% endif %}

    {% for sec in section_order | default(["work", "skills", "education", "projects", "publications", "certifications", "awards", "languages"]) if sec in _main_macros %}
    {{ _main_macros[sec]() }}
    {% endfor %}
  </main>
</div>
{% endblock %}
