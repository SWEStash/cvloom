{% extends "base.html.j2" %}

{% block fonts %}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap">
{% endblock %}

{% block css_vars %}
:root {
  --accent: #0f766e;
  --accent-light: #f0fdfa;
  --sidebar-bg: #0f766e;
  --sidebar-text: #ffffff;
  --sidebar-muted: rgba(255, 255, 255, 0.7);
  --font-body: Lato, Calibri, "Segoe UI", Arial, sans-serif;
}
{% endblock %}

{% block css_extra %}
.entry-header > .entry-date::before { content: " \00b7\0020"; }
/* Two-column sidebar layout */
/* CSS table, not CSS grid. WeasyPrint's grid fragmentation across page breaks is
   superlinear in page count: on a 60-entry CV this template took 69s to build
   against ~6s for the single-column ones, and it kept getting worse with length —
   long enough on a full CV to look like the build had hung. The same two columns
   expressed as a table fragment in 6.5s. Anonymous table boxes also make the
   column widths independent of any grid track sizing, so the layout is unchanged.

   `min-height: 100vh` used to stretch the sidebar band down the first page. It is
   gone: it was not what made the sidebar full-height (the table cell already does
   that), and vh units in paged media resolve against the page box, which pinned a
   minimum height onto a fragment that then had to be re-laid out. */
.layout {
  display: table;
  table-layout: fixed;
  width: 100%;
  margin: -12mm -14mm;
}
.sidebar {
  display: table-cell;
  width: 190px;
  vertical-align: top;
  background: var(--sidebar-bg);
  color: var(--sidebar-text);
  /* 12px each side, matching the print rule below. This was 14mm on the left —
     about 53px — which is the inset the band needs to clear the *page* edge, not
     the inset its own text needs. On screen the negative margin already pulls the
     band flush, so that 14mm landed on the text instead and pushed the whole
     sidebar column visibly right. The PDF was unaffected, which is why it survived:
     print overrides this padding entirely. */
  padding: 16mm 12px 12mm 12px;
  print-color-adjust: exact;
  -webkit-print-color-adjust: exact;
}
.sidebar h1 {
  font-size: 18pt;
  color: var(--sidebar-text);
  margin-bottom: 0.4em;
  line-height: 1.2;
}
.sidebar .headline {
  font-size: 9.5pt;
  color: var(--sidebar-muted);
  margin-bottom: 14px;
}
.sidebar .section-title {
  font-size: 8.5pt;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--sidebar-muted);
  border-bottom: 1px solid rgba(255, 255, 255, 0.25);
  padding-bottom: 2px;
  margin: 14px 0 6px;
  font-weight: 700;
}
.sidebar .contact-list {
  list-style: none;
  padding: 0;
  font-size: 8.5pt;
}
.sidebar .contact-list li {
  margin-bottom: 5px;
}
.sidebar .contact-label {
  display: block;
  font-size: 7pt;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--sidebar-muted);
}
.sidebar .contact-value {
  color: var(--sidebar-text);
  word-break: break-all;
}
/* Skills stack label-over-values, not one bordered chip per skill. In a 190px
   column a chip grid wraps after two or three items, so every skill costs most of
   a line and a fifteen-category list ran for pages; the borders also drew a box
   around each individual word, which is a lot of ink spent on no information. A
   comma list in the same column is roughly a third of the height. Stacked rather
   than side-by-side because there is no room here for a label column. */
.sidebar .skill-group { margin-bottom: 5px; break-inside: avoid; page-break-inside: avoid; }
.sidebar .skill-group-title {
  font-weight: 700;
  font-size: 8.5pt;
  margin-bottom: 1px;
  color: var(--sidebar-text);
}
.sidebar .skill-items {
  font-size: 8pt;
  color: var(--sidebar-muted);
  line-height: 1.3;
}
/* Proficiency bars, on the one template where they cost nothing.
   `skill_level_bar` renders an empty span: the level is carried by a CSS class, so
   there is no text in the PDF and no parser can read it. That rules it out of the
   five templates meant to survive extraction — but this one is already rated unsafe
   for a reason no styling fixes, so a decorative bar takes nothing away from it.
   Only mapping items with a `level` render one; a plain string skill renders none.
   The base rules use --border and --accent, neither of which reads on the band. */
.sidebar .skill-level { width: 26px; height: 4px; background: rgba(255, 255, 255, 0.25); }
.sidebar .skill-level::after { background: var(--sidebar-text); }
.sidebar .entry { margin-bottom: 8px; }
.sidebar .entry-title { font-weight: 700; font-size: 9pt; }
.sidebar .entry-meta { color: var(--sidebar-muted); font-size: 8pt; }
.sidebar .entry-date { color: var(--sidebar-muted); font-size: 7.5pt; }
.sidebar .languages {
  font-size: 8pt;
  color: var(--sidebar-muted);
  line-height: 1.3;
}

.main {
  display: table-cell;
  vertical-align: top;
  padding: 16mm 14mm 12mm 20px;
}
.main .section-title {
  font-size: 11pt;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent);
  font-weight: 700;
  border-left: 3px solid var(--accent);
  border-bottom: none;
  padding-left: 8px;
  padding-bottom: 0;
  margin: 16px 0 8px;
}
.main .entry { margin-bottom: 12px; }
.main .entry-header { margin-bottom: 2px; }
.main .entry-title { font-weight: 700; font-size: 10.5pt; }
.main .entry-org { color: var(--accent); font-weight: 600; }
.main .entry-date { color: var(--muted); font-size: 9pt; }
.main .entry-meta { color: var(--muted); font-size: 9pt; margin-bottom: 3px; }

@media print {
  .layout { margin: 0; }
  /* The teal band survives into the PDF. This block used to repaint the sidebar
     #f3f4f6 with black text, which meant the designed look existed only in the
     HTML preview and every actual PDF came out grey — the artefact nobody sees is
     the one that was styled. This template is already rated unsafe for parsing, so
     it is the one place in the set where the design gets to win outright.

     `box-decoration-break: clone` is what puts padding back on pages two and
     three. A fragmented box otherwise draws its padding only at the very start and
     the very end, so continuation pages had text sitting flush against the band. */
  .sidebar {
    padding: 12mm 12px 12mm 12px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .main {
    padding: 12mm 0 12mm 16px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
}
{% endblock %}

{# ── Sidebar section macros ─────────────────────────────────────── #}

{% macro sidebar_skills() %}
{% if show.skills and skills %}
<div class="section-title">{{ section_title("skills", "Skills") }}</div>
{% for group in skills %}
<div class="skill-group">
  <div class="skill-group-title">{{ group.category }}</div>
  <div class="skill-items">
    {%- for item in group['items'] -%}
      {%- if item is mapping -%}
        {{ item.name }}{% if item.level %}{{ item.level | skill_level_bar }}{% endif %}
      {%- else -%}{{ item }}{%- endif -%}
      {%- if not loop.last %}, {% endif -%}
    {%- endfor -%}
  </div>
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro sidebar_education() %}
{% if show.education and education %}
<div class="section-title">{{ section_title("education", "Education") }}</div>
{% for edu in education %}
<div class="entry">
  <div class="entry-title">{{ edu.degree }}{% if edu.field %} in {{ edu.field }}{% endif %}</div>
  <div class="entry-meta">{{ edu.institution }}</div>
  <div class="entry-date">{{ edu.start_date | date_range(edu.end_date | default(none)) }}</div>
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{# ── Main section macros ────────────────────────────────────────── #}

{% macro main_work() %}
{% if show.work and work %}
<div class="section-title">{{ section_title("work", "Experience") }}</div>
{% for job in work %}
<div class="entry">
  <div class="entry-header clearfix">
    <span class="entry-title">{{ job.title }}</span>
    <span class="entry-date">{{ job.start_date | date_range(job.end_date | default(none)) }}</span>
  </div>
  <div class="entry-meta">
    <span class="entry-org">{{ job.company }}</span>
    {% if job.location %} · {{ job.location }}{% endif %}
  </div>
  {% if job.highlights %}
  <ul>
    {% for h in job.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro main_projects() %}
{% if show.projects and projects %}
<div class="section-title">{{ section_title("projects", "Projects") }}</div>
{% for proj in projects %}
<div class="entry">
  <div class="entry-header clearfix">
    <span class="entry-title">
      {% if proj.url %}<a href="{{ proj.url }}">{{ proj.name }}</a>{% else %}{{ proj.name }}{% endif %}
    </span>
    {% if proj.start_date %}
    <span class="entry-date">{{ proj.start_date | date_range(proj.end_date | default(none)) }}</span>
    {% endif %}
  </div>
  {% if proj.description %}<p>{{ proj.description | md }}</p>{% endif %}
  {% if proj.highlights %}
  <ul>
    {% for h in proj.highlights %}<li>{{ h | md }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro main_publications() %}
{% if show.publications and publications %}
<div class="section-title">{{ section_title("publications", "Publications") }}</div>
{% for pub in publications %}
<div class="entry">
  <div class="entry-title">{% if pub.url %}<a href="{{ pub.url }}">{{ pub.name }}</a>{% else %}{{ pub.name }}{% endif %}</div>
  {% if pub.publisher or pub.identifier %}
  <div class="entry-meta">{{ pub.publisher }}{% if pub.publisher and pub.identifier %} · {% endif %}{{ pub.identifier }}</div>
  {% endif %}
  {% if pub.release_date %}<div class="entry-date">{{ pub.release_date }}</div>{% endif %}
  {% if pub.summary %}<p>{{ pub.summary | md }}</p>{% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro sidebar_certifications() %}
{% if show.certifications and certifications %}
{% for title_key, heading, group in certifications | cert_groups %}
<div class="section-title">{{ section_title(title_key, heading) }}</div>
{% for cert in group %}
<div class="entry">
  <div class="entry-title">{% if cert.url %}<a href="{{ cert.url }}">{{ cert.name }}</a>{% else %}{{ cert.name }}{% endif %}</div>
  {% if cert.issuer or cert.identifier %}<div class="entry-meta">{{ cert.issuer }}{% if cert.issuer and cert.identifier %} · {% endif %}{{ cert.identifier }}</div>{% endif %}
  {% if cert.date %}<div class="entry-date">{{ cert.date }}
  {%- if cert.expiry_date %} – {{ cert.expiry_date }}{% endif %}</div>{% endif %}
</div>
{% endfor %}
{% endfor %}
{% endif %}
{% endmacro %}

{% macro main_awards() %}
{% if show.awards and awards %}
<div class="section-title">{{ section_title("awards", "Awards") }}</div>
{% for award in awards %}
<div class="entry">
  <div class="entry-header clearfix">
    <span class="entry-title">{{ award.title }}</span>
    {% if award.date %}<span class="entry-date">{{ award.date }}</span>{% endif %}
  </div>
  {% if award.awarder %}<div class="entry-meta">{{ award.awarder }}</div>{% endif %}
  {% if award.summary %}<p>{{ award.summary | md }}</p>{% endif %}
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro sidebar_languages() %}
{% if show.languages and languages %}
<div class="section-title">{{ section_title("languages", "Languages") }}</div>
<div class="languages">
  {%- for lang in languages -%}
  <div>
  {{ lang.language }}{% if lang.fluency %} ({{ lang.fluency }}){% endif %}
  </div>
  {%- endfor %}
</div>
{% endif %}
{% endmacro %}

{# ── Section dispatch maps ──────────────────────────────────────── #}

{% set _sidebar_macros = {
  "skills": sidebar_skills,
  "education": sidebar_education,
  "certifications": sidebar_certifications,
  "languages": sidebar_languages,
} %}

{% set _main_macros = {
  "work": main_work,
  "projects": main_projects,
  "publications": main_publications,
  "awards": main_awards,
} %}

{% block body %}
<div class="layout">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <h1>{{ contact.name }}</h1>
    <div class="headline">{{ basics.headline }}</div>

    <div class="section-title">{{ section_title("contact", "Contact") }}</div>
    <ul class="contact-list">
      {% if contact.email is defined %}<li><span class="contact-label">Email</span><span class="contact-value">{{ contact.email }}</span></li>{% endif %}
      {% if contact.phone is defined %}<li><span class="contact-label">Phone</span><span class="contact-value">{{ contact.phone }}</span></li>{% endif %}
      {% if contact.location is defined %}<li><span class="contact-label">Location</span><span class="contact-value">{{ contact.location }}</span></li>{% endif %}
      {% for link in basics.links | default([]) %}<li><span class="contact-label">{{ link.label }}</span><span class="contact-value">{{ link | link_anchor }}</span></li>{% endfor %}
    </ul>

    {% for sec in section_order | default(["work", "skills", "education", "projects", "publications", "certifications", "awards", "languages"]) if sec in _sidebar_macros %}
    {{ _sidebar_macros[sec]() }}
    {% endfor %}
  </aside>

  <!-- MAIN -->
  <main class="main">
    {% if basics.summary %}
    <p style="margin-bottom: 12px;">{{ basics.summary | md }}</p>
    {% endif %}

    {% for sec in section_order | default(["work", "skills", "education", "projects", "publications", "certifications", "awards", "languages"]) if sec in _main_macros %}
    {{ _main_macros[sec]() }}
    {% endfor %}
  </main>
</div>
{% endblock %}
